rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Lecture publique pour tous, écriture réservée aux utilisateurs connectés
    match /menu/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /reviews/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /gallery/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /settings/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
